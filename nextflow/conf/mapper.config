//Parameters for mapping tools given specific sequencing chemistry
params {
  star_droplet = '--soloType CB_UMI_Simple --soloStrand Unstranded --soloUMIlen 12 --clipAdapterType CellRanger4 --outFilterScoreMin 30 --soloCBmatchWLtype 1MM_multi_Nbase_pseudocounts --soloUMIfiltering MultiGeneUMI_CR --soloUMIdedup 1MM_CR --soloCellFilter EmptyDrops_CR '
  star_smart = '--soloType SmartSeq --readFilesManifest manifest.tsv --soloUMIdedup Exact --soloStrand Unstranded'
}
