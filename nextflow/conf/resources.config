process {

    cpu = 1
    memory = 1.GB

    withName: qc_raw {
        memory = 20.GB
        cpus = 10
        time = { 8.h * task.attempt }
    }

    withName: mqc {
        memory = 12.GB
        cpus = 1
        time = { 8.h * task.attempt }
    }

    withName: Cellranger_idx {
        memory = 128.GB
        cpus = 24
        time = { 24.h * task.attempt }
    }

    withName: runCellrangerCount {
        memory = 96.GB
        cpus = 24
        time = { 24.h * task.attempt }
    }

    withName: useCellrangerData {
        memory = 1.GB
        cpus = 1
        time = 1.h
    }

    withName: star_idx {
        memory = 128.GB
        cpus = 24
        time = { 24.h * task.attempt }
    }

    withName: star_mapping {
        memory = 128.GB
        cpus = 24
        time = { 24.h * task.attempt }
    }

    withName: countBarcodesInChunks {
        memory = { 50.GB * task.attempt }
        cpus = 1
        time = { 8.h * task.attempt }
    }

    withName: mergeBarcodesInChunks {
        memory = { 50.GB * task.attempt }
        cpus = 1
        time = { 8.h * task.attempt }
    }

    withName: collapseAndFilterBarcodes {
        memory = { 32.GB * task.attempt }
        cpus = 1
        time = { 8.h * task.attempt }
    }

    withName: resolveMultiplets {
        memory = { 32.GB * task.attempt }
        cpus = 1
        time = { 4.h * task.attempt }
    }

    withName: generateReports {
        memory = { 16.GB * task.attempt }
        cpus = 1
        time = { 1.h * task.attempt }
    }

    withName: preprocessSingleCellData {
        memory = { 128.GB + 12.GB * task.attempt }
        cpus = 1
        time = { 8.h * task.attempt }
    }

    withName: createOverviewPlots {
        memory = { 84.GB + 12.GB * task.attempt }
        cpus = 1
        time = { 4.h * task.attempt }
    }

    withName: calculateBarcodeEnrichment {
        memory = { 84.GB + 12.GB * task.attempt }
        cpus = 1
        time = { 4.h * task.attempt }
    }

    withName: identifyDEGenes {
        memory = { 84.GB + 12.GB * task.attempt }
        cpus = 1
        time = { 4.h * task.attempt }
    }
}
