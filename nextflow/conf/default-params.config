params {
    // pipeline-specific parameters 
    sampleList = false
    optionalArgument = 'optional'

    // general pipeline parameters
    example = false
    help = false

    // default parameters
    mapperBin = "CellRanger"
    starMappingParams = "--soloFeatures Gene GeneFull SJ Velocyto\
                         --soloMultiMappers EM \
                         --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM \
                         --outSAMtype BAM SortedByCoordinate \
                         --outSAMprimaryFlag AllBestScore "
    starMappingParamsScale = "--soloFeatures GeneFull_Ex50pAS \
                               --soloMultiMappers PropUnique \
                               --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM \
                               --outSAMtype BAM SortedByCoordinate \
                               --outSAMprimaryFlag AllBestScore \
                               --soloCBwhitelist None "
    scriptDirR = '/tools/scripts/R/'
    scriptDirPy = '/tools/scripts/python/'
    binDir = '/usr/local/bin/'
    qcParams = ''
    runQC = null
    crParams = ""
    idxParams = ""
    whitelist = null
    refName = "Day0"
    mapIndex = null
    mapRef = null
    mapAnno = null
    filter = null
    organism = "Human"
    chunkSize = 1_000_000
    maxDist = 1
    maxDistCaTCH = 1
    maxDistUMIs = 1
    clusterMethodCaTCH = "directional"
    clusterMethodUMIs = "directional"
    stringency = "default"
    uniqueCaTCH = null
    minReads = 10
    minDetectedFeatures = 500
    minDetectedBarcodes = 10
    bc1Cutoff = 0.4
    bc2Cutoff = 0.3
    singletCutoff = 0.8
    majorityVote = 90
    maxMtPercent = 10
    hvgCutoff = 0.1
    pvalCutoff = 0.1
    lfcCutoff = 1
    // CaTCH barcode DE analysis, 'barbieq' (default) or 'deseq2' (legacy DESeq2/edgeR)
    de_method = 'barbieq'
    de_min_count = 10
    de_min_replicates = 2
    de_all_vs_all = false
    de_rds = null
    markerFile = '/tools/data/R/stagemarkers_xue2020.rds'

    // CLI-only aliases (fallback merged into the canonical params above in main.nf);
    // declared here as null so accessing them when unset doesn't warn
    fastqc_params = null
    mapper = null
    withQC = null
    cellranger_params = null
    star_params = null
    idx_params = null
    index = null
    reference = null
    annotation = null
    min_detected_barcodes = null
    markers = null
    singlet_cutoff = null
    bc1_cutoff = null
    bc2_cutoff = null
    max_mt_percent = null
    min_detected_features = null
    hvg_cutoff = null
    pval_cutoff = null
    lfc_cutoff = null
    reportsDir = "${launchDir}/REPORTS"
    outputDir = "${launchDir}/CaTCHseq_nf_OUTPUT"
    stopOnWarnings = true

}