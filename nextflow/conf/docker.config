process {

    withName: "Cellranger_idx|runCellrangerCount" {
        container = 'nf-core/cellranger:7.1.0'
    }

    withName: "qc_raw|mqc|star_idx|star_mapping|countBarcodesInChunks|mergeBarcodesInChunks|collapseAndFilterBarcodes|resolveMultiplets|generateReports|generateAnalyticsPlots|preprocessSingleCellData|createOverviewPlots|calculateBarcodeEnrichment|identifyDEGenes" {
        // container = 'docker.artifactory.imp.ac.at/obenauf/sccatch:main'
        container = "${params.pipelines_manual_ecr}/pipelines-test/singlecell-catch-nf:latest"
    }
}