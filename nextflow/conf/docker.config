process {

    withName: "runCellrangerCount" {
        container = 'nfcore/cellranger:7.1.0'
    }

    withName: "qc_raw|mqc|star_idx|star_mapping|countBarcodesInChunks|mergeBarcodesInChunks|collapseAndFilterBarcodes|resolveMultiplets|generateReports|generateAnalyticsPlots|preprocessSingleCellData|createOverviewPlots|createBarcodeEnrichmentPlots" {
        container = 'docker.artifactory.imp.ac.at/obenauf/sccatch:main'
    }
}