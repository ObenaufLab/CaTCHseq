params {
  config_profile_description = 'CBE.next (Vienna BioCenter) Slurm and Apptainer profile'
  config_profile_contact = 'Joerg Fallmann (@jfallmann)'
  config_profile_url = 'https://www.vbc.ac.at'
  cbe_account = null
  cbe_container_cache = System.getenv('NXF_APPTAINER_CACHEDIR') ?: (System.getenv('SCRATCHDIR') ? "${System.getenv('SCRATCHDIR')}/catchseq-apptainer" : "/scratch/users/${System.getProperty('user.name')}/catchseq-apptainer")
}

process {
  executor = 'slurm'
  queue = { task.memory <= 754.GB ? 'c' : 'm' }
  clusterOptions = { ->
    def time = task.time
    if (time == null || time <= 0.h || time > 14.d) {
      throw new IllegalArgumentException("task.time must be set, positive and at most 14.d, got ${time}")
    }
    def partition = task.queue
    if (!(partition in ['c', 'm'])) {
      throw new IllegalArgumentException("task.queue must be 'c' or 'm', got '${partition}'")
    }
    def tier = time <= 8.h ? 'short' : (time <= 48.h ? 'medium' : 'long')
    def options = "--qos=${partition}_${tier}"
    def account = params.cbe_account
    if (!account) return options
    def text = account.toString()
    if (!(text ==~ /^[A-Za-z0-9_.-]+$/)) {
      throw new IllegalArgumentException("params.cbe_account '${text}' must match " + /^[A-Za-z0-9_.-]+$/)
    }
    return options + " --account=${text}"
  }
  errorStrategy = { task.exitStatus in [9, 143, 137, 104, 134, 137, 138, 139, 140, 247] ? 'retry' : 'finish' }
  maxErrors = -1
  maxRetries = 3
}

executor {
  queueSize = 50
  pollInterval = Duration.of('60s')
  queueStatInterval = Duration.of('2m')
  submitRateLimit = '10/1min'
}

apptainer {
  enabled = true
  autoMounts = true
  cacheDir = params.cbe_container_cache
}

docker {
  enabled = false
}

singularity {
  enabled = false
}

podman {
  enabled = false
}

shifter {
  enabled = false
}

charliecloud {
  enabled = false
}
