//Parameters for mapping tools given specific sequencing chemistry
params {
  star_10X = "--soloType CB_UMI_Simple \
              --soloBarcodeReadLength 0 \
              --soloCBstart 1 \
              --soloCBlen 16 \
              --soloUMIstart 17 \
              --soloUMIlen 12 \
              --clipAdapterType CellRanger4 \
              --outFilterScoreMin 30 \
              --soloCBmatchWLtype 1MM_multi_Nbase_pseudocounts \
              --soloUMIfiltering MultiGeneUMI_CR \
              --soloUMIdedup 1MM_CR \
              --soloCellFilter EmptyDrops_CR "
  star_droplet = "--soloType CB_UMI_Simple \
                  --soloBarcodeReadLength 0 \
                  --soloCBstart 1 \
                  --soloCBlen 16 \
                  --soloUMIstart 17 \
                  --soloUMIlen 10 \
                  --outFilterScoreMin 30 \
                  --soloCBmatchWLtype 1MM_multi_Nbase_pseudocounts \
                  --soloUMIfiltering MultiGeneUMI_CR \
                  --soloUMIdedup 1MM_CR \
                  --soloCellFilter EmptyDrops_CR "
  star_scalebio =  "--soloCellReadStats Standard \
                    --soloBarcodeReadLength 0 \
                    --soloType CB_UMI_Simple \
                    --soloStrand Forward \
                    --soloCBstart 1 \
                    --soloCBlen 29 \
                    --soloUMIstart 30 \
                    --soloUMIlen 8"
  star_smart = "--soloType SmartSeq \
                --readFilesManifest manifest.tsv \
                --soloUMIdedup Exact \
                --soloStrand Unstranded"
}
